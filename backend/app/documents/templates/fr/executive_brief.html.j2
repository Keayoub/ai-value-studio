{% macro render_signal_block(tone_class, eyebrow, heading, items) -%}
  <article class="signal-block {{ tone_class }}">
    <div class="signal-block__eyebrow">{{ eyebrow }}</div>
    <h3>{{ heading }}</h3>
    <ul class="signal-list">
      {% for item in items %}
        <li class="signal-list__item">
          <div class="signal-list__title">{{ item.title }}</div>
          <p class="signal-list__summary">
            {% if item.ai_assisted %}<span class="ai-inline">{{ item.marker }}</span> — {% endif %}
            {{ item.body }}
          </p>
          {% if item.source_metadata %}
            <p class="source-metadata">
              {% for meta in item.source_metadata %}
                <span class="source-metadata__item">{{ meta.label }} ({{ meta.key }}) · {{ meta.source_label }}</span>
              {% endfor %}
            </p>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  </article>
{%- endmacro %}
<!doctype html>
<html lang="fr">
  <body>
    <header id="doc-header" class="running-header">
      <div class="running-header__grid">
        <div class="running-header__cell">{{ document_title }} · {{ use_case_title }}</div>
        <div class="running-header__cell running-header__cell--center">{{ program_name }} · v{{ version_no }}</div>
        <div class="running-header__cell running-header__cell--right">{{ review_status_label }}</div>
      </div>
    </header>

    <footer id="doc-footer" class="running-footer">
      <div class="running-footer__grid">
        <div class="running-footer__row">
          <div class="running-footer__cell running-footer__cell--meta">
            v{{ version_no }} · {{ generated_at_display }} · {{ generated_by }}
          </div>
          <div class="running-footer__cell running-footer__cell--right">{{ document_status_label }}</div>
        </div>
        <div class="running-footer__row">
          <div class="running-footer__cell running-footer__cell--meta">
            Confidentialité {{ confidentiality_label }} · évaluation v{{ assessment_version }} · scorecard v{{ scorecard_version }} · {{ review_status_footer_label }}
          </div>
          <div class="running-footer__cell running-footer__cell--right"><span class="page-counter"></span></div>
        </div>
      </div>
    </footer>

    <section class="cover">
      <div class="cover__eyebrow">AI Value Studio · Document de décision</div>
      <h1 class="cover__title">{{ document_title }}</h1>
      <p class="cover__subtitle">Cas d’usage «&nbsp;{{ use_case_title }}&nbsp;» · département {{ department }}</p>
      <p class="cover__lede">
        Cette note synthétise le snapshot verrouillé de l’évaluation, du scorecard et de la revue.
        Elle distingue explicitement les faits observés, les hypothèses restant à valider et les recommandations
        soumises à décision humaine.
      </p>

      <div class="cover__grid">
        <div class="cover__cell">
          <div class="cover-panel">
            <div class="cover-panel__label">Périmètre</div>
            <p>Programme «&nbsp;{{ program_name }}&nbsp;»</p>
            <p>Objectif déclaré&nbsp;: {{ program_objective }}</p>
            <p>Sponsor métier&nbsp;: {{ sponsor_name }}</p>
            <p>Auteur du rendu&nbsp;: {{ generated_by }}</p>
          </div>
          <div class="cover-panel">
            <div class="cover-panel__label">Signal de décision</div>
            <p>Recommandation de revue&nbsp;: <span class="badge badge--success">{{ recommendation_label }}</span></p>
            <p>Score de priorité&nbsp;: {{ priority_score_display }}</p>
            <p>Catégorie portefeuille&nbsp;: {{ category }}</p>
            <p>Risque déclaré&nbsp;: <span class="badge badge--risk">{{ risk_profile }}</span></p>
          </div>
        </div>

        <div class="cover__cell">
          <div class="cover-panel">
            <div class="cover-panel__label">Traçabilité</div>
            <p>Version documentaire&nbsp;: v{{ version_no }}</p>
            <p>Versions source&nbsp;: évaluation v{{ assessment_version }}, scorecard v{{ scorecard_version }}</p>
            <p>Statut documentaire&nbsp;: {{ document_status_label }}</p>
            <p>Revue source&nbsp;: {{ review_status_label }}</p>
          </div>
          <div class="status-block{% if approval_stamp.tone == 'draft' %} status-block--draft{% endif %}">
            <div class="status-block__eyebrow">Statut d’approbation</div>
            <div class="status-block__value">{{ approval_stamp.label }}</div>
            <ul class="status-block__meta">
              <li>Statut documentaire&nbsp;: {{ document_status_label }}</li>
              <li>Statut de revue&nbsp;: {{ review_status_label }}</li>
              <li>Version publiée&nbsp;: v{{ version_no }}</li>
            </ul>
            <p>{{ approval_stamp.detail }}</p>
          </div>
        </div>
      </div>
    </section>

    <section class="page page-break">
      <h2>1. Décision demandée</h2>
      <p class="page__intro">
        La décision ne porte pas sur une promesse générique, mais sur le cas d’usage tel qu’il ressort du snapshot source.
        Toute extension au-delà de ce périmètre doit faire l’objet d’une nouvelle version.
      </p>

      <div class="hero-card">
        <h3>Résumé exécutif</h3>
        <p>{{ executive_summary }}</p>
        <div class="quote">{{ factual_signal }}</div>
        <table class="meta-table">
          <tbody>
            <tr>
              <th>Pourquoi maintenant</th>
              <td>{{ why_now }}</td>
            </tr>
            <tr>
              <th>Coût de l’inaction</th>
              <td>{{ cost_of_inaction }}</td>
            </tr>
            <tr>
              <th>Opportunité observée</th>
              <td>{{ opportunity }}</td>
            </tr>
            <tr>
              <th>Responsable de revue</th>
              <td>{{ review_submitter }}</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="kpi-strip">
        <div class="kpi-strip__item">
          <div class="metric-card">
            <span class="metric-card__label">Valeur nette annuelle</span>
            <span class="metric-card__value">{{ net_annual_value_display }}</span>
            <div class="metric-card__detail">Lecture financière issue de la value assessment.</div>
          </div>
        </div>
        <div class="kpi-strip__item">
          <div class="metric-card">
            <span class="metric-card__label">KPI principal</span>
            <span class="metric-card__value">{{ kpi_baseline }}</span>
            <div class="metric-card__detail">Cible déclarée&nbsp;: {{ kpi_target }}</div>
          </div>
        </div>
        <div class="kpi-strip__item">
          <div class="metric-card">
            <span class="metric-card__label">Volume annuel</span>
            <span class="metric-card__value">{{ annual_volume_display }}</span>
            <div class="metric-card__detail">Durée actuelle&nbsp;: {{ duration_display }}</div>
          </div>
        </div>
        <div class="kpi-strip__item">
          <div class="metric-card">
            <span class="metric-card__label">Délai vers impact</span>
            <span class="metric-card__value">{{ payback_display }}</span>
            <div class="metric-card__detail">Le délai détaillé reste à confirmer au cadrage.</div>
          </div>
        </div>
      </div>
    </section>

    <section class="page">
      <h2>2. Faits établis et blocs de preuve</h2>
      <p class="page__intro">
        Les blocs suivants reprennent uniquement des informations présentes dans le snapshot source
        ou calculées de manière déterministe à partir de celui-ci.
      </p>
      {{ render_signal_block(
        "signal-block--facts",
        "Faits",
        "Faits établis",
        facts[:2],
      ) }}
      {% if facts|length > 2 %}
        {{ render_signal_block(
          "signal-block--facts",
          "Faits",
          "Faits établis (suite)",
          facts[2:],
        ) }}
      {% endif %}

      <h3>Blocs de preuve</h3>
      <div class="section-grid">
        <div class="section-grid__row">
          <div class="section-grid__cell">
            {% for block in evidence_blocks[:2] %}
              <article class="evidence-block">
                <div class="evidence-block__status">{{ block.status }}</div>
                <h3>{{ block.title }}</h3>
                <p>{{ block.summary }}</p>
                <p class="small">{{ block.details }}</p>
                {% if block.source_metadata %}
                  <p class="source-metadata">
                    {% for meta in block.source_metadata %}
                      <span class="source-metadata__item">{{ meta.label }} · {{ meta.source_label }}</span>
                    {% endfor %}
                  </p>
                {% endif %}
              </article>
            {% endfor %}
          </div>
          <div class="section-grid__cell">
            {% for block in evidence_blocks[2:] %}
              <article class="evidence-block">
                <div class="evidence-block__status">{{ block.status }}</div>
                <h3>{{ block.title }}</h3>
                <p>{{ block.summary }}</p>
                <p class="small">{{ block.details }}</p>
                {% if block.source_metadata %}
                  <p class="source-metadata">
                    {% for meta in block.source_metadata %}
                      <span class="source-metadata__item">{{ meta.label }} · {{ meta.source_label }}</span>
                    {% endfor %}
                  </p>
                {% endif %}
              </article>
            {% endfor %}
          </div>
        </div>
      </div>
    </section>

    <section class="page">
      <h2>3. Hypothèses à valider et recommandations</h2>
      <p class="page__intro">
        Les hypothèses n’ont pas valeur d’engagement automatique. Elles matérialisent les zones d’incertitude
        qui devront être confirmées pendant le pilote ou la due diligence documentaire avant toute extension.
      </p>
      {{ render_signal_block(
        "signal-block--hypotheses",
        "Hypothèses à valider",
        "Hypothèses à valider",
        hypotheses[:1],
      ) }}
      {% if hypotheses|length > 1 %}
        {{ render_signal_block(
          "signal-block--hypotheses",
          "Hypothèses à valider",
          "Hypothèses à valider (suite)",
          hypotheses[1:],
        ) }}
      {% endif %}

      <div class="lead-signal-group">
        <h3 class="section-subheading">Recommandations</h3>
        <p class="page__intro">
          Les recommandations ci-dessous traduisent la lecture actuelle du dossier en décisions proposées,
          sans remplacer la validation humaine finale.
        </p>
        {{ render_signal_block(
          "signal-block--recommendations",
          "Recommandations",
          "Recommandations",
          recommendations[:1],
        ) }}
      </div>
      {% if recommendations|length > 1 %}
        {{ render_signal_block(
          "signal-block--recommendations",
          "Recommandations",
          "Recommandations (suite)",
          recommendations[1:],
        ) }}
      {% endif %}
    </section>

    <section class="page">
      <h2>4. Économie, score et garde-fous</h2>
      <p class="page__intro">
        Les montants et scores ci-dessous sont calculés à partir des versions sources verrouillées.
        Ils ne constituent pas une validation d’investissement autonome.
      </p>

      <div class="metric-grid">
        <div class="metric-grid__item">
          <div class="metric-card">
            <span class="metric-card__label">Valeur brute</span>
            <span class="metric-card__value">{{ gross_value_display }}</span>
            <div class="metric-card__detail">Avant coût annuel de solution.</div>
          </div>
        </div>
        <div class="metric-grid__item">
          <div class="metric-card">
            <span class="metric-card__label">Gains de temps</span>
            <span class="metric-card__value">{{ time_value_display }}</span>
            <div class="metric-card__detail">Hypothèse basée sur le volume annuel et le temps économisé.</div>
          </div>
        </div>
        <div class="metric-grid__item">
          <div class="metric-card">
            <span class="metric-card__label">Évitement d’erreurs</span>
            <span class="metric-card__value">{{ error_value_display }}</span>
            <div class="metric-card__detail">Lecture monétaire de la baisse d’erreurs déclarée.</div>
          </div>
        </div>
        <div class="metric-grid__item">
          <div class="metric-card">
            <span class="metric-card__label">Readiness moyenne</span>
            <span class="metric-card__value">{{ readiness_average_display }}</span>
            <div class="metric-card__detail">Scorecard source.</div>
          </div>
        </div>
      </div>

      <table class="score-table">
        <thead>
          <tr>
            <th>Dimension</th>
            <th>Score</th>
            <th>Poids</th>
            <th>Confiance</th>
            <th>Justification</th>
          </tr>
        </thead>
        <tbody>
          {% for row in score_dimensions %}
            <tr>
              <td>{{ row.label }}</td>
              <td>{{ row.score }}/5</td>
              <td>{{ row.weight }}</td>
              <td>{{ row.confidence }}</td>
              <td>{{ row.justification }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>

      <div class="callout">
        <strong>Décision attendue&nbsp;:</strong> confirmer si le cas d’usage peut avancer en pilote dans le cadre décrit,
        avec les garde-fous humains, data et conformité explicités ci-dessus.
      </div>
    </section>

    <section class="page">
      <div class="traceability-lead keep-together">
        <h2>5. Annexes de traçabilité</h2>
        <p class="page__intro">
          Le registre suivant identifie les champs-clés mobilisés dans le document et leur provenance déclarée.
        </p>

        <table class="source-table">
          <thead>
            <tr>
              <th>Champ</th>
              <th>Clé source</th>
              <th>Valeur de snapshot</th>
              <th>Origine</th>
            </tr>
          </thead>
          <tbody>
            {% for item in source_register[:3] %}
              <tr>
                <td>{{ item.label }}</td>
                <td>{{ item.key }}</td>
                <td>{{ item.value }}</td>
                <td>{{ item.source_label }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

      {% if source_register|length > 3 %}
        <table class="source-table">
          <thead>
            <tr>
              <th>Champ</th>
              <th>Clé source</th>
              <th>Valeur de snapshot</th>
              <th>Origine</th>
            </tr>
          </thead>
          <tbody>
            {% for item in source_register[3:] %}
              <tr>
                <td>{{ item.label }}</td>
                <td>{{ item.key }}</td>
                <td>{{ item.value }}</td>
                <td>{{ item.source_label }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      {% endif %}
    </section>
  </body>
</html>
