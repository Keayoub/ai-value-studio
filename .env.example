# S2 backend foundation: local defaults are safe only for loopback + SQLite development.
APP_ENV=local
DEBUG=true
DATABASE_URL=sqlite:///./backend/ai_value_studio.db
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
AUTH_MODE=dev

ENTRA_TENANT_ID=
ENTRA_API_CLIENT_ID=
ENTRA_API_AUDIENCE=
ENTRA_REQUIRED_SCOPE=access_as_user
ENTRA_JWKS_CACHE_TTL=300

DEV_DEFAULT_SUBJECT=dev:workspace-admin
DEV_DEFAULT_NAME=Local Workspace Admin
DEV_USER_ROLE=WorkspaceAdmin
DEV_WORKSPACE_ID=

NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1
NEXT_PUBLIC_AUTH_MODE=dev
NEXT_PUBLIC_ENTRA_CLIENT_ID=
NEXT_PUBLIC_ENTRA_TENANT_ID=
NEXT_PUBLIC_API_SCOPE=api://your-api-client-id/access_as_user

LLM_PROVIDER=local
LLM_MODEL=local
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=2024-02-15

DOCUMENT_STORAGE_DRIVER=local
DOCUMENT_STORAGE_PATH=/absolute/path/outside/the/repository/ai-value-studio-documents
DOCUMENT_STORAGE_ACCOUNT=
DOCUMENT_STORAGE_CONTAINER=ai-value-studio-local
DOCUMENT_STORAGE_KEY_PREFIX=local/
DOCUMENT_STORAGE_CREDENTIAL=

ELECTRON_ENTRA_CLIENT_ID=
ELECTRON_ENTRA_TENANT_ID=
ELECTRON_API_SCOPE=
ELECTRON_AUTHORIZED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:8000,http://localhost:8000
